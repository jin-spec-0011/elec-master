{
  "rules": {
    ".read": false,
    ".write": false,
    "elec": {
      "pool": {
        ".read": "auth != null",
        ".write": false,
        "$cid": {
          ".indexOn": ["status"]
        }
      },
      "meta": {
        ".read": "auth != null",
        ".write": false
      },
      "users": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
